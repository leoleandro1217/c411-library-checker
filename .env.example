# Copy this file to .env, then set a strong password and your personal C411 API key.
# Never commit the real .env file to GitHub.
APP_USERNAME=admin
APP_PASSWORD=change-this-password
C411_API_KEY=YOUR_PERSONAL_C411_API_KEY
C411_API_URL=https://c411.org/api/torznab
# Max ~13.3 searches/minute to stay under C411's 15 requests/min limit.
REQUEST_INTERVAL_SECONDS=4.5
CACHE_DAYS=30
MEDIA_ROOT=/media
DATA_DIR=/config
HOST=0.0.0.0
PORT=8787

# Optional integrations. URLs must be reachable FROM THIS Docker container.
# Jellyfin path mapping: Jellyfin /data/Movies/Film.mkv -> /media/Movies/Film.mkv
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_PATH_PREFIX=/data

# qBittorrent: either QBIT_API_KEY (v5.2+ Bearer key) OR username/password.
# qBit API access here is read-only; no torrents are added/removed.
QBIT_URL=
QBIT_API_KEY=
QBIT_USERNAME=
QBIT_PASSWORD=

# Optional cross-seed v6+ daemon. Search is triggered manually by the UI.
# cross-seed may inject torrents depending on ITS OWN configuration.
CROSS_SEED_URL=
CROSS_SEED_API_KEY=

# 0 = no scheduled scans. For example 360 = rescan every 6 hours.
# An incremental scan reuses cached C411 results for unchanged movies.
AUTO_SCAN_MINUTES=0

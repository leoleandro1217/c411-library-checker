# Copy this file to .env, then set a strong password and your personal C411 API key.
# Never commit the real .env file to GitHub.
APP_USERNAME=admin
APP_PASSWORD=change-this-password
C411_API_KEY=YOUR_PERSONAL_C411_API_KEY
C411_API_URL=https://c411.org/api/torznab
# Max ~13.3 searches/minute to stay under C411's 15 requests/min limit.
REQUEST_INTERVAL_SECONDS=4.5
CACHE_DAYS=30
MEDIA_ROOT=/media
DATA_DIR=/config
HOST=0.0.0.0
PORT=8787
